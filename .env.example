# Anchor — local dev environment.
#
# Copy to `.env`, edit, then either:
#   - Source it before bootRun:    `set -a; source .env; set +a; ./gradlew :anchor-server:bootRun`
#   - Or just run scripts/smoke-test.sh — it auto-sources .env if present.
#
# Spring Boot reads these as system env vars; the `${...:default}` form in
# anchor-server/src/main/resources/application.yml falls back if unset.

# ---- LM Studio ----
# OpenAI-compatible endpoint. The Mac Studio default is the typical layout for
# this project; adjust to your LAN host. Trailing /v1 is required.
LM_STUDIO_BASE_URL=http://mac-studio.local:1234/v1

# Chat model identifier as exposed by LM Studio's /models endpoint. Whatever
# you've loaded under "Chat" — Gemma 4 E4B is the v0 default.
LM_STUDIO_CHAT_MODEL=gemma-3-4b-it

# Embedding model identifier. Must produce 768-dim vectors; the schema is
# fixed at vector(768) — see V1__schema.sql. nomic-embed-text-v1.5 is the
# v0 default and matches that width.
LM_STUDIO_EMBEDDING_MODEL=nomic-embed-text-v1.5

# Bearer token for the OpenAI-compatible endpoint. Leave empty for vanilla
# local LM Studio (no auth). Set when pointing at real OpenAI, vLLM with
# auth enabled, an Anthropic-compat proxy, etc. — the same token is sent
# on chat (blocking + streaming), embedding, and the /models health probe.
# Treat as a secret; .env is gitignored.
LM_STUDIO_API_KEY=

# ---- Postgres ----
# Defaults match docker-compose.yml; only override if you're pointing at a
# different pgvector instance.
ANCHOR_DB_URL=jdbc:postgresql://localhost:5433/anchor
ANCHOR_DB_USER=anchor
ANCHOR_DB_PASSWORD=anchor

# ---- Server ----
# ANCHOR_PORT=8080
# WORKER_CHAT_POOL_SIZE=1            (single Gemma slot)
# WORKER_EMBEDDING_POOL_SIZE=2       (nomic handles 2 in parallel)
# WORKER_DELIBERATION_POOL_SIZE=4
# WORKER_INGEST_POOL_SIZE=1
