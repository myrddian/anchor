# Anchor — local dev environment.
#
# Copy to `.env`, edit, then `./gradlew :anchor-server:bootRun` —
# the build auto-loads .env for every bootRun and Test task. Same for
# scripts/smoke-test.sh (which auto-sources it as well).
#
# Already-exported shell env wins: a one-off `LLM_BASE_URL=… ./gradlew …`
# overrides the .env value. Spring Boot reads these as system env vars; the
# `${...:default}` form in anchor-server/src/main/resources/application.yml
# falls back if unset.

# ---- Inference provider ----
# Anchor speaks the OpenAI chat-completions and embeddings wire format. Point
# this at anything that follows the same shape — LM Studio (the dev default),
# real OpenAI, vLLM, llama.cpp's HTTP server, ollama's OpenAI-compat shim, etc.
# Trailing /v1 is required.
LLM_BASE_URL=http://mac-studio.local:1234/v1

# Chat model identifier as exposed by the provider's /models endpoint.
# Gemma 4 E4B is the v0 dev default.
LLM_CHAT_MODEL=gemma-3-4b-it

# Embedding model identifier. Must produce 768-dim vectors; the schema is
# fixed at vector(768) — see V1__schema.sql. nomic-embed-text-v1.5 matches
# that width and is the v0 default.
LLM_EMBEDDING_MODEL=nomic-embed-text-v1.5

# Bearer token for the OpenAI-compatible endpoint. Leave empty for vanilla
# local LM Studio (no auth). Set when pointing at real OpenAI, vLLM with
# auth enabled, an Anthropic-compat proxy, etc. — the same token is sent
# on chat (blocking + streaming), embedding, and the /models health probe.
# Kept under the LM_STUDIO_API_KEY name on purpose — Anthropic vs OpenAI
# key semantics diverge enough that a generic name would invite confusion.
# Treat as a secret; .env is gitignored.
LM_STUDIO_API_KEY=

# Back-compat: the previous LM_STUDIO_BASE_URL / LM_STUDIO_CHAT_MODEL /
# LM_STUDIO_EMBEDDING_MODEL still resolve if you have them in your shell
# already, but new deployments should use the LLM_* names above.

# ---- Postgres ----
# Defaults match docker-compose.yml; only override if you're pointing at a
# different pgvector instance.
ANCHOR_DB_URL=jdbc:postgresql://localhost:5433/anchor
ANCHOR_DB_USER=anchor
ANCHOR_DB_PASSWORD=anchor

# ---- Server ----
# ANCHOR_PORT=8090
# WORKER_CHAT_POOL_SIZE=1            (single Gemma slot)
# WORKER_EMBEDDING_POOL_SIZE=2       (nomic handles 2 in parallel)
# WORKER_DELIBERATION_POOL_SIZE=4
# WORKER_INGEST_POOL_SIZE=1

# ---- Auth ----
# Bearer token enforced on every request when set. Leave empty for the
# default localhost workflow; populate before binding the service to a
# non-loopback interface or fronting it with a reverse proxy. Clients
# (anchor-client / anchor-shell / Python / Node SDKs) read the same value.
# Generate with: openssl rand -hex 32
ANCHOR_API_TOKEN=

# ---- Web UI ----
# Single-page browser UI at /. On by default for the dev / chemist demo
# workflow; set to false on API-only deployments to 404 the static assets
# entirely. When the UI is on AND ANCHOR_API_TOKEN is set, the page shows
# a token-prompt overlay on load and stores the token in sessionStorage.
# ANCHOR_WEB_UI_ENABLED=true

# ---- OpenAPI / Swagger UI ----
# Spec at /v3/api-docs (JSON), interactive UI at /swagger-ui/index.html.
# Both enabled by default — the spec is the contract, useful for
# integrators and curl users. Set false on hardened deployments.
# ANCHOR_OPENAPI_ENABLED=true
